# Copy to .env. Never commit .env or tokens.
PORT=3000
FILLER_PYTHON=.venv/bin/python
FILLER_ASR_MODEL=Systran/faster-whisper-small
# Optional language; omit for model detection.
# FILLER_LANGUAGE=en
# Enable after installing requirements-diarization.txt and accepting model conditions.
FILLER_DIARIZE=0
# HF_TOKEN=
# Full chat-completions URL for your chosen local or hosted compatible model.
# A hosted endpoint receives meeting transcripts when enabled.
# FILLER_LLM_URL=http://localhost:11434/v1/chat/completions
# FILLER_LLM_MODEL=your-installed-model
# FILLER_LLM_KEY=
