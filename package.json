{
  "name": "@dne-labs/filler",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "check": "turbo run check",
    "test": "turbo run test",
    "simulate": "pnpm --filter @filler/simulator build && pnpm --filter @filler/simulator simulate",
    "simulate:workers": "pnpm --filter @filler/simulator build && node apps/simulator/dist/index.js --workers 4 --requests 100"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.19.1"
  }
}
