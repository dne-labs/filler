{
  "name": "@dne-labs/filler",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "check": "turbo run check",
    "test": "turbo run test",
    "simulate": "pnpm --filter @filler/simulator build && pnpm --filter @filler/simulator simulate",
    "simulate:workers": "pnpm --filter @filler/simulator build && node apps/simulator/dist/index.js --workers 4 --requests 100",
    "simulate:autoscale": "pnpm --filter @filler/simulator build && node apps/simulator/dist/index.js --requests 100 --workers 1 --autoscale --max-workers 6",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "web:dev": "pnpm --filter @filler/web dev",
    "web:build": "pnpm --filter @filler/web build",
    "web:check": "pnpm --filter @filler/web check",
    "backend:dev": "pnpm --filter @filler/backend dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.19.1"
  },
  "description": "A Turborepo voice inference scheduler with priority queues, worker coordination, retries, request controls, and workload simulations."
}
